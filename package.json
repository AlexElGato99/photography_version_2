{
  "name": "pod-dashboard",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "clean": "node scripts/clean-next.js",
    "reinstall": "npx --yes rimraf@5 node_modules .next node_modules/.cache && npm install",
    "ci:install": "npx --yes rimraf@5 node_modules .next node_modules/.cache && npm ci",
    "dev": "next dev",
    "dev:clean": "npm run clean && npm run dev",
    "rebuild:sharp": "npm rebuild sharp",
    "postinstall": "node scripts/postinstall-rebuild-sharp.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:check": "node scripts/db-check.cjs",
    "db:migrate": "node scripts/run-migrations.cjs",
    "migrate:sql": "node scripts/run-sql-file.cjs",
    "migrate:categories": "node scripts/run-sql-file.cjs supabase/migrations/20260212_categories_page_fields.sql"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@tiptap/extension-hard-break": "^3.23.1",
    "@tiptap/extension-link": "^3.23.1",
    "@tiptap/pm": "^3.23.1",
    "@tiptap/react": "^3.23.1",
    "@tiptap/starter-kit": "^3.23.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^0.383.0",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^2.12.7",
    "sharp": "^0.34.5",
    "tailwind-merge": "^2.3.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/sharp": "^0.31.1",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "pg": "^8.13.1"
  }
}
